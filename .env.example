# ============================================================
# ローカル開発用の設定例。`npm run setup` が .env にコピーします。
# ============================================================

# データベース (ローカルは SQLite)。
# Vercel + PostgreSQL では Storage 連携が DATABASE_URL を自動設定するため、この値は使いません。
DATABASE_URL="file:./dev.db"

# ファイル実体の保存先: local (ローカルディスク) | database (DB の FileBlob テーブル)
# 未設定時はローカルでは local、Vercel 上では database が自動選択されます。
# FILE_STORAGE_PROVIDER=local
FILE_STORAGE_DIR="./storage/uploads"

# AI 支援 (任意)。未設定の場合はルールベースの候補生成で動作します。
# ANTHROPIC_API_KEY=

# デプロイ時のビルドで DB が空ならサンプルデータを投入する (0 で無効化)
# SEED_ON_BUILD=1
